# ==========================================
# CONFIGURATION - Système de Gestion PEA
# ==========================================
# Copiez ce fichier en .env et remplissez vos clés API

# ==========================================
# APIs FINANCIÈRES
# ==========================================

# Yahoo Finance (GRATUIT - Pas de clé nécessaire)
YAHOO_FINANCE_ENABLED=true


# ==========================================
# IA AVANCÉE (Choix: Claude OU OpenAI)
# ==========================================

# Option 1: Anthropic Claude (RECOMMANDÉ)
# Prix: ~0.003$/1k tokens (très abordable)
# Site: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_ICI

# Option 2: OpenAI GPT-4 (Alternative)
# Prix: ~0.03$/1k tokens
# Site: https://platform.openai.com/
# OPENAI_API_KEY=sk-VOTRE_CLE_ICI


# ==========================================
# NEWS & SENTIMENT
# ==========================================

# News API (GRATUIT - 100 requêtes/jour)
# Site: https://newsapi.org/
# NEWS_API_KEY=VOTRE_CLE_ICI

# SerpAPI - Google News (GRATUIT - 100 recherches/mois)
# Site: https://serpapi.com/
# SERPAPI_KEY=VOTRE_CLE_ICI


# ==========================================
# TELEGRAM NOTIFICATIONS
# ==========================================

# Créer un bot: Parler à @BotFather sur Telegram
# Commandes: /newbot puis suivre les instructions
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Votre Chat ID (récupérer via @userinfobot sur Telegram)
# TELEGRAM_CHAT_ID=votre_chat_id


# ==========================================
# DATABASE
# ==========================================

# SQLite par défaut (pas besoin de config)
DATABASE_URL=sqlite:///./data/portfolio.db

# Pour PostgreSQL (optionnel, production):
# DATABASE_URL=postgresql://user:password@localhost/portfolio_db


# ==========================================
# CONFIGURATION SYSTÈME
# ==========================================

# Environnement
ENVIRONMENT=development

# Niveau de logs
LOG_LEVEL=INFO

# Port API
API_PORT=8000
