# ==========================================
# CONFIGURATION - Agent PEA
# ==========================================

# ==========================================
# API CONFIGURATION
# ==========================================

# URL de base de l'API (pour Docker: http://api:8000, pour local: http://localhost:8000)
API_BASE_URL=http://localhost:8000

# ==========================================
# JWT AUTHENTICATION (USAGE PERSONNEL)
# ==========================================

# Secret JWT (OBLIGATOIRE - Générer avec: openssl rand -hex 32)
# IMPORTANT: Changez cette valeur en production!
JWT_SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# Credentials single user (usage personnel)
API_USERNAME=admin
API_PASSWORD=your_secure_password_here

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================

# Token du bot Telegram (obtenu depuis @BotFather)
# Exemple: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID du chat Telegram (obtenu depuis @userinfobot)
# Doit être un ID numérique, pas un username
# Exemple: 123456789
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# TELEGRAM BOT SECURITY (Usage personnel)
# ==========================================

# ID(s) Telegram autorisé(s) à utiliser le bot
# OBLIGATOIRE pour protéger votre bot contre les accès non autorisés
#
# Comment obtenir votre ID Telegram:
# 1. Parler à @userinfobot sur Telegram
# 2. Le bot vous donnera votre ID numérique
#
# Format:
# - Single ID: TELEGRAM_AUTHORIZED_USER_IDS=123456789
# - Multiple IDs (séparés par virgules): TELEGRAM_AUTHORIZED_USER_IDS=123456789,987654321
#
# IMPORTANT:
# - Utilisez UNIQUEMENT des IDs numériques (pas de @username)
# - Si cette variable n'est PAS configurée, le bot sera accessible à TOUS
# - Pour usage personnel, configurez UNIQUEMENT votre propre ID
#
# Exemple:
TELEGRAM_AUTHORIZED_USER_IDS=123456789

# ==========================================
# AI SERVICES (Optionnel)
# ==========================================

# Anthropic API Key (pour Claude AI - PRIORITÉ 1)
# Obtenir une clé: https://console.anthropic.com/
# Claude est utilisé en PRIORITÉ pour toutes les analyses IA
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (pour analyses IA - Fallback)
# Obtenir une clé: https://platform.openai.com/api-keys
# OpenAI est utilisé seulement si Claude n'est pas disponible
OPENAI_API_KEY=sk-...

# ==========================================
# NEWS API (Optionnel)
# ==========================================

# News API Key (pour actualités - 100 requêtes/jour gratuit)
# Obtenir une clé: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# ==========================================
# DONNÉES DE MARCHÉ
# ==========================================

# Yahoo Finance (GRATUIT - aucune clé requise)
# Utilisé automatiquement par le système pour:
# - Prix en temps réel (délai 15-20 min)
# - Historique des cours
# - Informations des actions (P/E, dividende, etc.)

# ==========================================
# OLLAMA (Génération de réponses RAG)
# ==========================================

# Ollama est utilisé pour générer des réponses à partir du RAG
# Installation: https://ollama.ai/download
# Modèle par défaut: mistral
# Commande: ollama pull mistral

# ==========================================
# BASE DE DONNÉES
# ==========================================

# SQLite (local)
# Les bases de données sont stockées dans:
# - data/portfolio.db (portfolio et trésorerie)
# - data/vector_db/ (ChromaDB pour RAG)

# ==========================================
# NOTES IMPORTANTES
# ==========================================

# Variables OBLIGATOIRES pour le bot Telegram:
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_CHAT_ID
# - API_BASE_URL (par défaut: http://localhost:8000)

# Variables OPTIONNELLES (fonctionnalités avancées):
# - OPENAI_API_KEY (analyse IA, construction portfolio)
# - ANTHROPIC_API_KEY (analyse sentiment avec Claude)
# - NEWSAPI_KEY (actualités récentes)

# Fonctionnalités GRATUITES (sans clé API):
# ✅ Portfolio management complet
# ✅ Trésorerie PEA
# ✅ Opportunités IA (détection)
# ✅ Données marché temps réel (Yahoo Finance)
# ✅ Analyse technique (RSI, MACD, Bollinger)
# ✅ RAG v2 (recherche documents)
# ✅ Bot Telegram (toutes commandes)

# ==========================================
# DÉPLOIEMENT
# ==========================================

# Pour déploiement VPS avec Docker:
# 1. Copier ce fichier: cp .env.example .env
# 2. Remplir les variables obligatoires
# 3. Lancer: docker-compose up -d --build

# Pour développement local:
# 1. Copier ce fichier: cp .env.example .env
# 2. Remplir les variables obligatoires
# 3. API: cd api && python -m uvicorn main:app --reload
# 4. Bot: python telegram_bot_main.py
# 5. Scheduler: python telegram_scheduler.py

# ==========================================
# SUPPORT
# ==========================================

# Documentation complète: README.md
# Guide utilisation: GUIDE_UTILISATION.md
# Déploiement VPS: DEPLOYMENT.md
# Troubleshooting: TROUBLESHOOTING.md
